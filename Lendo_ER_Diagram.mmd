    APP_USERS {
        bigint user_id PK
        varchar email UK
        text password_hash
        varchar first_name
        varchar last_name
        boolean is_active
    }
    USER_ROLES {
        bigint user_id PK,FK
        varchar role_name PK
    }
    IDENTITY_VERIFICATIONS {
        bigint verification_id PK
        bigint user_id FK
        varchar document_type
        varchar status
        bigint reviewed_by_user_id FK
    }
    CATEGORIES {
        bigint category_id PK
        bigint parent_id FK
        varchar name
        varchar slug UK
    }
    LISTINGS {
        bigint listing_id PK
        bigint owner_id FK
        bigint category_id FK
        varchar title
        varchar status
        numeric rate_amount
        varchar rate_unit
        numeric deposit_percent
    }
    LISTING_PHOTOS {
        bigint photo_id PK
        bigint listing_id FK
        text photo_url
        boolean is_primary
    }
    LISTING_LOCATIONS {
        bigint listing_id PK,FK
        varchar city
        varchar address_line1
        numeric latitude
        numeric longitude
    }
    LISTING_UNAVAILABILITY {
        bigint unavailability_id PK
        bigint listing_id FK
        bigint created_by_user_id FK
        timestamptz starts_at
        timestamptz ends_at
    }
    BOOKINGS {
        bigint booking_id PK
        bigint listing_id FK
        bigint borrower_id FK
        timestamptz starts_at
        timestamptz ends_at
        varchar status
        numeric rental_amount
        numeric deposit_amount
    }
    BOOKING_STATUS_HISTORY {
        bigint history_id PK
        bigint booking_id FK
        varchar previous_status
        varchar new_status
    }
    BOOKING_EXTENSIONS {
        bigint extension_id PK
        bigint booking_id FK
        bigint requested_by_user_id FK
        timestamptz requested_ends_at
        varchar status
    }
    PAYMENTS {
        bigint payment_id PK
        bigint booking_id FK
        bigint payer_user_id FK
        bigint payee_user_id FK
        varchar payment_type
        numeric amount
        varchar status
    }
    PAYOUT_ACCOUNTS {
        bigint payout_account_id PK
        bigint user_id FK
        text provider_account_token UK
        boolean is_verified
    }
    PAYOUTS {
        bigint payout_id PK
        bigint booking_id FK
        bigint user_id FK
        bigint payout_account_id FK
        numeric amount
        varchar status
    }
    HANDOVER_CONFIRMATIONS {
        bigint confirmation_id PK
        bigint booking_id FK
        varchar stage
        bigint confirmed_by_user_id FK
    }
    CONDITION_REPORTS {
        bigint condition_report_id PK
        bigint booking_id FK
        bigint submitted_by_user_id FK
        varchar stage
        varchar item_condition
    }
    CONDITION_REPORT_PHOTOS {
        bigint condition_photo_id PK
        bigint condition_report_id FK
        text photo_url
    }
    CONVERSATIONS {
        bigint conversation_id PK
        bigint booking_id FK,UK
    }
    MESSAGES {
        bigint message_id PK
        bigint conversation_id FK
        bigint sender_user_id FK
        text message_body
    }
    NOTIFICATIONS {
        bigint notification_id PK
        bigint recipient_user_id FK
        bigint actor_user_id FK
        bigint booking_id FK
        varchar notification_type
    }
    REVIEWS {
        bigint review_id PK
        bigint booking_id FK
        bigint listing_id FK
        bigint reviewer_user_id FK
        bigint reviewee_user_id FK
        smallint overall_rating
    }
    REVIEW_REPORTS {
        bigint review_report_id PK
        bigint review_id FK
        bigint reported_by_user_id FK
        varchar status
    }
    SUPPORT_TICKETS {
        bigint ticket_id PK
        bigint user_id FK
        bigint booking_id FK
        varchar category
        varchar status
    }
    SUPPORT_TICKET_MESSAGES {
        bigint ticket_message_id PK
        bigint ticket_id FK
        bigint sender_user_id FK
        text message_body
    }
    GUIDELINE_ACCEPTANCES {
        bigint acceptance_id PK
        bigint user_id FK
        varchar guideline_version
    }
